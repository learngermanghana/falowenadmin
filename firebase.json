{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "falowenadmin",
      "disallowLegacyRuntimeConfig": true,
      "predeploy": [
        "node scripts/patchStudentPaymentLinks.mjs",
        "node scripts/patchStudentPaymentHistoryApi.mjs",
        "node scripts/patchStudentPaymentAdminSecurity.mjs",
        "node scripts/patchStudentProfileUpdateApi.mjs",
        "node scripts/patchAutomaticOrientationSync.mjs",
        "node scripts/patchStructuredWritingEvidence.mjs",
        "node scripts/patchSpecificWritingFeedback.mjs",
        "node --check functions/index.js",
        "node scripts/patchSheetRowManagementRoutes.mjs",
        "node scripts/patchOperationalSheetAutoSyncJobs.mjs",
        "node scripts/patchLiveClassUpdateScheduleSync.mjs",
        "node scripts/patchHolidayClassScheduleAwareness.mjs",
        "node scripts/patchStudentDeletionRuntime.mjs",
        "node scripts/patchStudentLeadDeletionRuntime.mjs",
        "node scripts/patchAttendanceConfirmationEmails.mjs",
        "node scripts/patchClassSessionReminderEmails.mjs",
        "node scripts/patchLeadClassStartReminderEmails.mjs",
        "node scripts/patchAutoCompleteClassSessions.mjs",
        "node scripts/patchCourseReviewRequestEmails.mjs",
        "node scripts/patchGoetheExamConfig.mjs"
      ],
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ]
    }
  ]
}
