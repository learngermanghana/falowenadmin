rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.get('admin', false) == true ||
        request.auth.token.get('staff', false) == true ||
        request.auth.token.get('role', '') in ['admin', 'staff', 'tutor'] ||
        request.auth.token.get('email', '') in ['moxflex@gmail.com','staff@falowen.app']
      );
    }

    // Staff may review old and nested student submissions, but students can
    // only read documents carrying their own authenticated identity.
    match /{path=**}/submissions/{submissionId} {
      allow read: if isAdmin() || (isSignedIn() &&
        (resource.data.get('studentId', '') == request.auth.uid ||
         resource.data.get('userId', '') == request.auth.uid ||
         resource.data.get('uid', '') == request.auth.uid));
      allow write: if isAdmin();
    }

    // Historical level/student/attempt layout used by the monitoring page.
    match /submissions/{level}/{studentId}/{attemptId} {
      allow read, write: if isAdmin();
    }

    match /{path=**}/posts/{postId} {
      allow read, write: if isAdmin();
    }

    match /examTutorReviewQueue/{docId} { allow read, write: if isAdmin(); }
    match /ai_issue_reports/{docId} { allow read, write: if isAdmin(); }
    match /markingJobs/{docId} { allow read, write: if isAdmin(); }

    // Answer key sync metadata written by Falowen Admin.
    // Restricted teacher drafts. Never expose draft questions or answer keys to students.
    match /mockFactoryDrafts/{draftId} {
      allow read: if isAdmin();
      allow create: if isAdmin()
        && request.resource.data.id == draftId
        && request.resource.data.level in ['A1','A2','B1','B2','C1','C2']
        && request.resource.data.status in ['draft','review'];
      allow update: if isAdmin()
        && resource.data.id == draftId
        && request.resource.data.id == draftId
        && request.resource.data.level == resource.data.level
        && request.resource.data.status in ['draft','review'];
      allow delete: if false;
    }

    match /answerKeyRegistry/{docId} {
      allow read, write: if isAdmin();
    }

    match /answerKeySyncRuns/{docId} {
      allow read, write: if isAdmin();
    }

    // Writing submissions can be monitored from the admin dashboard.
    match /writingSubmissions/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Live class administration collections used by /live-classes.
    match /classes/{classId} {
      allow read, write: if isAdmin();
    }

    match /classSessions/{sessionId} {
      allow read, write: if isAdmin();
    }

    match /attendance/{classId}/sessions/{sessionId} {
      allow read, write: if isAdmin();
    }

    match /attendance/{classId}/sessions/{sessionId}/{document=**} {
      allow read, write: if isAdmin();
    }

    match /calendarFeeds/{feedId} {
      allow read, write: if isAdmin();
    }

    match /auditLogs/{logId} {
      allow read, write: if isAdmin();
    }

    match /studentNotifications/{notificationId} {
      allow read, write: if isAdmin();
    }

    match /emailQueue/{emailId} {
      allow read, write: if isAdmin();
    }

    // Do not deploy this file blindly if your live project already has broader
    // Firestore rules in Firebase Console. Merge these answer-key rules into
    // your existing rules first so other admin pages do not lose access.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
