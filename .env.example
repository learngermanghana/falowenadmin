# Falowen Admin local development template. Copy to .env and fill from private setup.
# VITE_* values are bundled for browser consumption; never put a server secret here.
VITE_FIREBASE_API_KEY=replace-with-browser-sdk-config
VITE_FIREBASE_AUTH_DOMAIN=replace-with-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=replace-with-project-id
VITE_FIREBASE_STORAGE_BUCKET=replace-with-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=replace-with-sender-id
VITE_FIREBASE_APP_ID=replace-with-browser-app-id
VITE_API_BASE_URL=
VITE_OPEN_SESSION_API_URL=/api/openSession
VITE_CHECKIN_API_URL=/api/checkin

# Set private server-side secrets in deployment environment/Secret Manager, not here.
