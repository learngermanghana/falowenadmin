{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/__falowen-admin-build.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    },
    {
      "source": "/(.*).mp3",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/attendance-confirmation-emails/health",
      "destination": "https://us-central1-falowen-examiner-trainer.cloudfunctions.net/api/attendance-confirmation-emails/health"
    },
    {
      "source": "/api/attendance-confirmation-emails/retry-failed",
      "destination": "https://us-central1-falowen-examiner-trainer.cloudfunctions.net/api/attendance-confirmation-emails/retry-failed"
    },
    {
      "source": "/api/admin/draft-history/:draftId/queue-marking",
      "destination": "https://us-central1-falowen-examiner-trainer.cloudfunctions.net/api/admin/draft-history/:draftId/queue-marking"
    },
    {
      "source": "/api/admin/draft-history/:draftId",
      "destination": "https://us-central1-falowen-examiner-trainer.cloudfunctions.net/api/admin/draft-history/:draftId"
    },
    {
      "source": "/api/admin/draft-history",
      "destination": "https://us-central1-falowen-examiner-trainer.cloudfunctions.net/api/admin/draft-history"
    },
    {
      "source": "/api/admin/timed-drafts/recover",
      "destination": "https://us-central1-falowen-examiner-trainer.cloudfunctions.net/api/admin/timed-drafts/recover"
    },
    {
      "source": "/api/admin/timed-drafts",
      "destination": "https://us-central1-falowen-examiner-trainer.cloudfunctions.net/api/admin/timed-drafts"
    },
    {
      "source": "/api/class-participation/(.*)",
      "destination": "https://us-central1-falowen-examiner-trainer.cloudfunctions.net/api/class-participation/$1"
    },
    {
      "source": "/api/calendar/(.*)",
      "destination": "https://us-central1-falowen-examiner-trainer.cloudfunctions.net/api/calendar/$1"
    },
    {
      "source": "/api/payments/(.*)",
      "destination": "https://us-central1-falowen-examiner-trainer.cloudfunctions.net/api/payments/$1"
    },
    {
      "source": "/api/student-leads/(.*)",
      "destination": "https://us-central1-falowen-examiner-trainer.cloudfunctions.net/api/student-leads/$1"
    },
    {
      "source": "/api/admin/marking-health",
      "destination": "https://us-central1-falowen-examiner-trainer.cloudfunctions.net/api/admin/marking-health"
    },
    {
      "source": "/api/admin/signup-account-lookup",
      "destination": "https://us-central1-falowen-examiner-trainer.cloudfunctions.net/api/admin/signup-account-lookup"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/router?path=$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "git": {
    "deploymentEnabled": {
      "main": true,
      "*": false
    }
  }
}
